{
  "manifest_version": 3,
  "name": "FocusTube",
  "version": "4.0",
  "permissions": ["storage" ],
  "host_permissions": [
    "https://www.youtube.com/*" ,
     "http://localhost:5000/*"   
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
} 